<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<h1>My Blog</h1>
<a href="/create">Create Post</a>

<% posts.forEach(post => { %>
  <div class="post">
    <h2><%= post.title %></h2>
    <p><%= post.content %></p>

    <a href="/edit/<%= post.id %>">Edit</a>
    <a href="/delete/<%= post.id %>">Delete</a>
  </div>
<% }) %>

</body>
</html>
